# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key — server only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Single-operator passcode gate
ADMIN_PASSCODE=change-me-to-something-strong

# Secret used to sign session cookies AND voucher QR tokens (HMAC)
SESSION_SECRET=generate-a-long-random-string
QR_SECRET=generate-another-long-random-string

# Base URL the QR codes point at (no trailing slash)
VERIFY_BASE=https://your-app.vercel.app
